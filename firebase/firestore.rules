rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function owns(uid){ return signedIn() && request.auth.uid == uid; }
    match /users/{uid} {
      allow read, write: if owns(uid);
      match /items/{itemId} {
        allow read: if owns(uid);
        allow create, update: if owns(uid)
          && request.resource.data.mode in ['watch','play','read','go']
          && request.resource.data.status in ['saved','queued','in_progress','completed','dropped'];
        allow delete: if owns(uid);
      }
      match /preferences/{docId} { allow read, write: if owns(uid); }
    }
  }
}
