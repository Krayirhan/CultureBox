RAWG_API_KEY=
GOOGLE_BOOKS_API_KEY=
# Turns on real Firebase Auth/Firestore (android/app/google-services.json is
# already committed for culturebox-krayirhan). Without this, sign-in/sign-up
# fall back to a device-only stub.
CULTUREBOX_FIREBASE=true
CONTEXT7_API_KEY=
GITHUB_PERSONAL_ACCESS_TOKEN=
FIREBASE_PROJECT_ID=culturebox-krayirhan
ANDROID_PACKAGE_NAME=com.krayirhanstudio.culturebox
# GitHub Actions Secrets only:
# PLAY_SERVICE_ACCOUNT_JSON
# ANDROID_KEYSTORE_BASE64
# ANDROID_KEYSTORE_PASSWORD
# ANDROID_KEY_ALIAS
# ANDROID_KEY_PASSWORD
